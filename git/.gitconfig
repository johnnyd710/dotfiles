[core]
	editor = code --wait
	autocrlf = false
[user]
	email = 19596966+johnnyd710@users.noreply.github.com
	name = John DiMatteo
[color]
	ui = auto
[diff]
	tool = vscode
	algorithm = histogram
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[merge]
	tool = vscode
	conflictStyle = zdiff3
[mergetool "vscode"]
	cmd = code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"
[init]
	defaultBranch = main
[pull]
	rebase = merges
[rerere]
	enabled = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
